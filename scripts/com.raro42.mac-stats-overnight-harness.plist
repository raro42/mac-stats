<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.raro42.mac-stats-overnight-harness</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-u</string>
		<string>/Users/raro42/projects/mac-stats/scripts/run_overnight_harness_loop.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/raro42/projects/mac-stats</string>
